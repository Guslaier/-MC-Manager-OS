# Linux-native example. Copy to `.env.linux` and fill in local values. Never commit it.
# Loaded by apps/server/load-env.ts on non-win32 hosts, AFTER the shared `.env`, so these
# values override it: a Windows-only UNC `MCM_DATA_DIR` / `MCM_RUNTIME_MODE=wsl` kept in
# `.env` for the Windows dev box can therefore never leak into a Linux host.

# --- Runtime ---
NODE_ENV=development
PORT=3001

# --- Engine: host runc (no WSL layer) ---
# `auto`/unset = drive the host `runc` directly; `native` = docker+runc via the docker CLI.
# `wsl` is Windows-only and is refused on Linux.
MCM_RUNTIME_MODE=auto
# runc rootfs template prepared on the host (must not be under /mnt/*)
MCM_WSL_ROOTFS=/var/lib/mcm/rootfs
MCM_WSL_BUNDLE_DIR=/var/lib/mcm/bundles
MCM_WSL_RUNC_ROOT=/var/lib/mcm/runc-state

# --- Data / server defaults ---
# Leave MCM_DATA_DIR unset to use the Linux default `~/.mc-manager`.
# Never set it to a Windows UNC path such as \\wsl.localhost\... here.
# MCM_DATA_DIR=/home/<user>/.mc-manager
MCM_MAX_UPLOAD_BYTES=536870912
MCM_SERVER_IMAGE=itzg/minecraft-server

# --- Auth (single-user) ---
MCM_MASTER_PASSWORD=change-me-local-password
# Generate: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
MCM_JWT_SECRET=replace-with-64-hex-chars
MCM_JWT_TTL_SECONDS=43200
