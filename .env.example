# Windows/WSL2 example. Copy to `.env.windows` (or `.env`) and fill in local values.
# Never commit .env files. Loaded by apps/server/load-env.ts, which prefers the
# platform-specific file `.env.windows` on win32 and `.env.linux` on Linux, and only
# falls back to the shared `.env`.
#
# The values below are WINDOWS-ONLY: the UNC MCM_DATA_DIR and MCM_RUNTIME_MODE=wsl are
# rejected on Linux. For a Linux host use `.env.linux.example` instead.

# --- Runtime ---
NODE_ENV=development
PORT=3001

# --- Engine: WSL mode ---
MCM_RUNTIME_MODE=wsl
MCM_WSL_DISTRO=MC-Manager-OS
# runc rootfs template directory INSIDE the distro (must not be under /mnt/*)
MCM_WSL_ROOTFS=/var/lib/mcm/rootfs
MCM_WSL_BUNDLE_DIR=/var/lib/mcm/bundles
MCM_WSL_RUNC_ROOT=/var/lib/mcm/runc-state

# --- Data / server defaults ---
# Canonical server storage root. Default target is the container-side distro filesystem
# (`/server/<id>` inside MCM_WSL_DISTRO), reached from Windows over UNC. No host folder.
MCM_DATA_DIR=\\wsl.localhost\MC-Manager-OS\server
# Optional: pre-canonical PC root the non-destructive migration copies FROM (defaults to
# <repo>/apps/server/data). Never written to or deleted by the migration.
# MCM_LEGACY_PC_ROOT=C:\path\to\old\data
MCM_MAX_UPLOAD_BYTES=536870912
MCM_SERVER_IMAGE=itzg/minecraft-server

# --- Auth (single-user) ---
MCM_MASTER_PASSWORD=change-me-local-password
# Generate: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
MCM_JWT_SECRET=replace-with-64-hex-chars
MCM_JWT_TTL_SECONDS=43200
